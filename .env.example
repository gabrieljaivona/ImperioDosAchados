# PostgreSQL (Hostinger)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/imperio?schema=public"

# Token Bearer que o bot usa em SITE_API_TOKEN (gere com: openssl rand -hex 32)
SITE_API_TOKEN=

# NEXT_PUBLIC_*: embutidas no build — defina antes de `npm run build`
# URL pública do site (sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# ID do Meta Pixel (só carrega após consentimento de cookies)
NEXT_PUBLIC_META_PIXEL_ID=
# Link de convite do grupo VIP
NEXT_PUBLIC_VIP_GROUP_URL=
